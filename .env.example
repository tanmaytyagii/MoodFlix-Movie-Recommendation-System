# ---------------------------------------------------------------------------
# MoodFlix environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Note there is deliberately no VITE_ prefix on these. Vite inlines any VITE_*
# variable into the client bundle, which would put the credential straight back
# into shipped JavaScript. These are read only by the serverless functions in
# `api/`, so the secrets stay server-side.
# ---------------------------------------------------------------------------

# REQUIRED — TMDB v4 Read Access Token (not the v3 API key).
# Create one at https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_tmdb_v4_read_access_token_here

# OPTIONAL — Hugging Face token, enables the hosted emotion model at /api/emotion.
# Without it MoodFlix falls back to the local lexicon engine and works normally.
# Create one at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=

# OPTIONAL — override the emotion model.
# Default: j-hartmann/emotion-english-distilroberta-base
HUGGINGFACE_EMOTION_MODEL=
